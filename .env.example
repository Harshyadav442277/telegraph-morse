# Copy to .env for local runs. Set the same names in Vercel → Settings → Environment Variables.
# The operator sets every value. Claude never sees or writes the private key.

# Payer wallet: a NEW burner on Base Sepolia funded from https://faucet.circle.com (USDC only).
# Never the Track 1 miner wallet.
EVM_PRIVATE_KEY=0x_burner_private_key

# Telegram bot from @BotFather, and a random secret Telegram must echo on every webhook call.
TELEGRAM_BOT_TOKEN=123456:token
TELEGRAM_WEBHOOK_SECRET=long_random_string

# Neon Postgres (Vercel Marketplace → Neon → connection string).
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Operator-only endpoints (key issuance overrides, kill switch, re-sync).
ADMIN_TOKEN=long_random_string

# Salt for hashing user identifiers before they are stored. Rotating it resets user counts.
HASH_SALT=long_random_string

# Budgets. Calls per UTC day. 0 disables paid work entirely — the safe default before funding.
DAILY_BUDGET_CALLS=0
PER_TELEGRAM_USER_DAILY=40
PER_WEB_SESSION_DAILY=20
PER_API_KEY_DAILY=100
KILL_SWITCH=false

TELEGRAPH_NODE=https://devnode.telegraphprotocol.com
MORSE_PUBLIC_URL=https://<your-vercel-host>
